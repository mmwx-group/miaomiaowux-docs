{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mmwx-docs",
  "compatibility_date": "2026-05-22",
  // 只有 /api/* 进 Worker(更新日志的 GitHub Release 缓存,见 worker/index.ts),其余仍是纯静态资源
  "main": "worker/index.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // SPA fallback: 任何未命中静态文件的路径都返回 dist/index.html(状态码 200),
    // 让 React Router 接管客户端路由。不加这一行,/docs/* 等纯前端路由直接访问会 404。
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
